    # ------------------------------------------------------------ data
    def load(self, name):
        try:
            return MQ.load_box(name)
        except SystemExit:
            return None

    def programs_of(self, b):
        """[(command string, display name, icon)] for the qube's programs."""
        root = MQ.TEMPLATES / b["template"]
        known = {shlex.join(cmd): (name, icon) for name, cmd, icon in template_apps(root)} if root.is_dir() else {}
        out = []
        for cmd in b.get("apps", []):
            fallback = (cmd.split() or ["?"])[0]
            name, icon = known.get(cmd, (fallback, QIcon()))
            out.append((cmd, name, icon))
        return out

    def refresh(self, select=None):
        cur = select or self.name
        self.qubes.blockSignals(True)
        self.qubes.clear()
        for n in (sorted(p.stem for p in MQ.CONF.glob("*.toml")) if MQ.CONF.is_dir() else []):
            b = self.load(n)
            if b is None:
                continue
            it = QListWidgetItem(swatch(b["color"], 20), f"{n}\n{kind_of(b)}")
            it.setData(Qt.UserRole, n)
            self.qubes.addItem(it)
            if n == cur:
                self.qubes.setCurrentItem(it)
        self.qubes.blockSignals(False)
        if self.qubes.currentItem() is None and self.qubes.count():
            self.qubes.setCurrentRow(0)
        self.on_select(self.qubes.currentItem())
        self.refresh_admin()

    def on_select(self, item, _prev=None):
        self.name = item.data(Qt.UserRole) if item else None
        b = self.load(self.name) if self.name else None
        if b is None:
            self.name = None
            self.title.setText("  No qube selected. Click '+ New qube'.")
            self.title.setStyleSheet("font-size:22pt; font-weight:bold; padding:10px;")
            self.notice.hide()
            self.details.setEnabled(False)
            clear_layout(self.grid)
            self.shares.clear()
            return

        c = b["color"]
        self.title.setText(f"  {self.name}")
        self.title.setStyleSheet(f"font-size:22pt; font-weight:bold; padding:10px; background:{c}; "
                                 f"color:{contrast(c)};")
        self.details.setEnabled(True)
        self.loading = True
        try:
            i = self.internet.findData(b.get("network", "none"))
            self.internet.setCurrentIndex(i if i >= 0 else 0)
            self.forget.setChecked(not b.get("persistent", True))
            self.frame.setChecked(bool(b.get("frame", True)))
            self.clip.setChecked(bool(b.get("clipboard", True)))
            self.sound.setChecked(bool(b.get("sound")))
            self.camera.setChecked(bool(b.get("camera")))
            self.set_color(c)
            level = b.get("seccomp", "none")
            self.security.clear()
            for key, label, _ in SECURITY:
                self.security.addItem(label, key)
            if level not in [k for k, _, _ in SECURITY]:
                self.security.addItem(OTHER_SECURITY.get(level, level), level)
            self.security.setCurrentIndex(self.security.findData(level))
            self.security_help.setText(describe(level))
            self.fill_shares(b)
            self.fill_programs(b)
            self.notice.setVisible(not (MQ.TEMPLATES / b["template"]).is_dir())
        finally:
            self.loading = False

    def fill_programs(self, b):
        clear_layout(self.grid)
        progs = self.programs_of(b)
        if not progs:
            self.grid.addWidget(QLabel("No programs yet. Click '+ Add program' below."), 0, 0)
            return
        for i, (cmd, name, icon) in enumerate(progs):
            btn = QToolButton()
            btn.setText(name)
            btn.setIcon(icon)
            btn.setIconSize(QSize(64, 64))
            btn.setToolButtonStyle(Qt.ToolButtonTextUnderIcon)
            btn.setMinimumSize(150, 130)
            btn.clicked.connect(lambda _=False, c=cmd: self.launch(c))
            self.grid.addWidget(btn, i // 4, i % 4)

    def fill_shares(self, b):
        self.shares.clear()
        for s in b.get("shares", []):
            path, mode = s.rsplit(":", 1)
            self.shares.addItem(f"{path}   ({'can change files' if mode == 'rw' else 'view only'})")

    # ------------------------------------------------------------ settings
    def set_color(self, c):
        self.color = c
        self.colorbtn.setText(c)
        self.colorbtn.setStyleSheet(f"background:{c}; color:{contrast(c)}; padding:6px 14px;")

    def pick_color(self):
        c = QColorDialog.getColor(QColor(self.color), self, "Qube color")
        if c.isValid():
            self.set_color(c.name())
            self.save_settings()

    def on_security_changed(self, _index=0):
        self.security_help.setText(describe(self.security.currentData()))
        self.save_settings()

    def save_settings(self, *_):
        if self.loading or not self.name:
            return
        b = self.load(self.name)
        if b is None:
            return
        b["network"] = self.internet.currentData()
        b["persistent"] = not self.forget.isChecked()
        b["tier"] = "disposable" if self.forget.isChecked() else "trusted"
        b["frame"] = self.frame.isChecked()
        b["clipboard"] = self.clip.isChecked()
        b["sound"] = self.sound.isChecked()
        b["camera"] = self.camera.isChecked()
        b["seccomp"] = self.security.currentData()
        b["color"] = self.color
        MQ.write_box(self.name, b)
        self.refresh()

    # ------------------------------------------------------------ qubes
    def new_qube(self):
        dlg = NewQube(self)
        if dlg.exec() != QDialog.Accepted:
            return
        name = dlg.name.text().strip()
        r = subprocess.run([CLI, "create", name, "--preset", dlg.kind.currentData()],
                           capture_output=True, text=True)
        if r.returncode != 0:
            QMessageBox.warning(self, "Couldn't make qube", (r.stdout + r.stderr).strip())
            return
        self.refresh(select=name)

    def delete_qube(self):
        if not self.name:
            return
        if QMessageBox.question(self, "Delete qube", f"Delete '{self.name}' and everything saved in it? "
                                                    f"This can't be undone.") != QMessageBox.Yes:
            return
        r = subprocess.run([CLI, "delete", self.name, "--yes"], capture_output=True, text=True)
        if r.returncode != 0:
            QMessageBox.warning(self, "Couldn't delete", (r.stdout + r.stderr).strip())
        self.name = None
        self.refresh()

    def add_program(self):
        if not self.name:
            return
        b = self.load(self.name)
        root = MQ.TEMPLATES / b["template"]
        if not root.is_dir():
            QMessageBox.information(self, "Base system missing",
                                    "Set up the base system first: Setup > Set up the base system.")
            return
        apps = template_apps(root)
        if not apps:
            QMessageBox.information(self, "No programs", "No programs are installed in the base system yet. "
                                                         "Use Setup > Install a program into the base system.")
            return
        dlg = PickProgram(self, apps)
        if dlg.exec() != QDialog.Accepted or not dlg.chosen:
            return
        cmd = shlex.join(dlg.chosen)
        if cmd not in b.get("apps", []):
            b["apps"] = [*b.get("apps", []), cmd]
            MQ.write_box(self.name, b)
        self.refresh(select=self.name)

    def remove_program(self):
        if not self.name:
            return
        b = self.load(self.name)
        progs = self.programs_of(b)
        if not progs:
            QMessageBox.information(self, "No programs", "This qube has no programs to remove.")
            return
        labels = [name for _, name, _ in progs]
        item, ok = QInputDialog.getItem(self, "Remove a program", "Remove which program?", labels, 0, False)
        if not ok:
            return
        i = labels.index(item)
        b["apps"] = [cmd for j, (cmd, _, _) in enumerate(progs) if j != i]
        MQ.write_box(self.name, b)
        self.refresh(select=self.name)

    def add_share(self):
        if not self.name:
            return
        d = QFileDialog.getExistingDirectory(self, "Pick a folder to share with this qube")
        if not d:
            return
        can_change = QMessageBox.question(
            self, "Share folder",
            f"Let this qube CHANGE files in:\n{d}\n\nYes = it can change and delete files\n"
            f"No = it can only look") == QMessageBox.Yes
        b = self.load(self.name)
        b["shares"] = [*b.get("shares", []), f"{d}:{'rw' if can_change else 'ro'}"]
        MQ.write_box(self.name, b)
        self.refresh(select=self.name)

    def remove_share(self):
        row = self.shares.currentRow()
        if not self.name or row < 0:
            return
        b = self.load(self.name)
        b["shares"] = [s for j, s in enumerate(b.get("shares", [])) if j != row]
        MQ.write_box(self.name, b)
        self.refresh(select=self.name)

    # ------------------------------------------------------------ running programs
    def launch(self, cmd):
        if not self.name:
            return
        fd, log = tempfile.mkstemp(prefix="mq-run-", suffix=".log")
        with os.fdopen(fd, "w") as f:
            p = subprocess.Popen([CLI, "run", self.name, "--", *shlex.split(cmd)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=f,
                                 start_new_session=True)
        self.procs.append((p, log))

    def reap(self):
        """Collect finished programs; show an error if one failed to start."""
        for p, log in list(self.procs):
            code = p.poll()
            if code is None:
                continue
            self.procs.remove((p, log))
            text = Path(log).read_text(errors="replace").strip()[-1500:] if Path(log).exists() else ""
            Path(log).unlink(missing_ok=True)
            if code != 0:
                QMessageBox.warning(self, "Couldn't open that program", text or f"Exit code {code}")

    # ------------------------------------------------------------ setup (opens a terminal for sudo)
    def terminal(self, argv):
        t = find_terminal()
        if not t:
            QMessageBox.warning(self, "No terminal", "Couldn't find a terminal program (foot, kitty, alacritty, "
                                                     "konsole, xterm ...). Install one.")
            return
        term, flags = t
        script = shlex.join(argv) + '; echo; printf "Done. Press Enter to close... "; read _'
        subprocess.Popen([term, *flags, "sh", "-c", script], start_new_session=True)

    def build_base(self):
        self.terminal([CLI, "template", "build", DEFAULT_TEMPLATE])

    def update_base(self):
        self.terminal([CLI, "template", "update", DEFAULT_TEMPLATE])

    def admin_shell(self):
        self.terminal([CLI, "template", "shell", DEFAULT_TEMPLATE])

    def install_program(self):
        text, ok = QInputDialog.getText(
            self, "Install programs", "Package names, space separated (for example: vlc libreoffice).\n"
                                      "For sound, include: libpulse\nFor copy/paste between qubes, include: wl-clipboard\nIdeas: " + SUGGESTIONS)
        if ok and text.strip():
            self.terminal([CLI, "template", "install", DEFAULT_TEMPLATE, *text.split()])

    def refresh_admin(self):
        ready = (MQ.TEMPLATES / DEFAULT_TEMPLATE).is_dir()
        self.build_btn.setVisible(not ready)
        for b in self.admin_btns:
            b.setEnabled(ready)
        self.tpl_label.setText(
            f"Base system '{DEFAULT_TEMPLATE}' is ready. Programs installed here appear in every qube."
            if ready else "The base system isn't set up yet. Click the button below (first time only).")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("MiniQubes")
    app.setStyleSheet("QWidget { font-size: 13pt; } QPushButton { padding: 8px 16px; }")
    w = Main()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
