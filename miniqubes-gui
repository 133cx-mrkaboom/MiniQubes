def load_mq():
    path = os.environ.get("MQ_CLI") or shutil.which("miniqubes")
    if not path:
        sys.exit("miniqubes-gui: `miniqubes` isn't in PATH. Install it first.")
    loader = importlib.machinery.SourceFileLoader("mq", path)
    spec = importlib.util.spec_from_loader("mq", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod, path


MQ, CLI = load_mq()

TERMS = [("foot", []), ("alacritty", ["-e"]), ("kitty", []), ("konsole", ["-e"]), ("qterminal", ["-e"]),
         ("lxterminal", ["-e"]), ("xfce4-terminal", ["-x"]), ("gnome-terminal", ["--"]),
         ("wezterm", ["start", "--"]), ("xterm", ["-e"])]


def find_terminal():
    for t, flags in TERMS:
        if shutil.which(t):
            return t, flags
    return None


def swatch(color, size=16):
    pm = QPixmap(size, size)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    p.setBrush(QColor(color))
    p.setPen(Qt.NoPen)
    p.drawRoundedRect(0, 0, size, size, 4, 4)
    p.end()
    return QIcon(pm)


def contrast(color):
    c = QColor(color)
    return "#000000" if (c.red() * 299 + c.green() * 587 + c.blue() * 114) / 1000 > 150 else "#ffffff"


def find_icon(root, name):
    if not name:
        return QIcon()
    if name.startswith("/"):
        p = root / name.lstrip("/")
        return QIcon(str(p)) if p.exists() else QIcon()
    best, best_size = None, -1
    for f in glob.glob(str(root / f"usr/share/icons/hicolor/*/apps/{name}.*")):
        folder = Path(f).parent.parent.name
        size = int(folder.split("x")[0]) if folder[:1].isdigit() else 64
        if size <= 128 and size > best_size:
            best, best_size = f, size
    if not best:
        hits = glob.glob(str(root / f"usr/share/pixmaps/{name}.*"))
        best = hits[0] if hits else None
    return QIcon(str(in_root(root, best))) if best else QIcon()


def in_root(root, p):
    """Follow symlinks as if `root` were / (links inside a template point at the template, not at this computer)."""
    root, cur, hops = Path(root), Path(root), 0
    parts = list(Path(p).relative_to(root).parts)
    while parts:
        part = parts.pop(0)
        if part == "..":
            cur = cur.parent if cur != root else cur
            continue
        nxt = cur / part
        if nxt.is_symlink() and hops < 40:
            hops += 1
            t = os.readlink(nxt)
            if t.startswith("/"):
                cur, parts = root, list(Path(t).parts[1:]) + parts
            else:
                parts = list(Path(t).parts) + parts
        else:
            cur = nxt
    return cur


def template_apps(root):
    apps = []
    for f in sorted(glob.glob(str(root / "usr/share/applications/*.desktop"))):
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        cp.optionxform = str
        try:
            cp.read(in_root(root, f), encoding="utf-8")
        except Exception:
            continue
        if "Desktop Entry" not in cp:
            continue
        d = cp["Desktop Entry"]
        if d.get("Type", "Application") != "Application":
            continue
        if d.get("NoDisplay", "").lower() == "true" or d.get("Hidden", "").lower() == "true":
            continue
        if d.get("Terminal", "").lower() == "true":
            continue
        try:
            cmd = [t for t in shlex.split(d.get("Exec", "")) if not t.startswith("%")]
        except ValueError:
            continue
        if cmd:
            apps.append((d.get("Name", Path(f).stem), cmd, find_icon(root, d.get("Icon", ""))))
    apps.sort(key=lambda a: a[0].lower())
    return apps


def kind_of(b):
    if not b.get("persistent", True):
        return "Throwaway"
    return "Everyday" if b.get("network") in ("direct", "internet") else "Offline"


def describe(level):
    for key, _, text in SECURITY:
        if key == level:
            return text
    return ""


def clear_layout(layout):
    while layout.count():
        w = layout.takeAt(0).widget()
        if w:
            w.hide()                 # gone at once, not "later" (no ghost buttons while resizing)
            w.setParent(None)
            w.deleteLater()


class PickProgram(QDialog):
    def __init__(self, parent, apps):
        super().__init__(parent)
        self.setWindowTitle("Add a program")
        self.resize(460, 600)
        self.chosen = None
        self.list = QListWidget()
        self.list.setIconSize(QSize(40, 40))
        for name, cmd, icon in apps:
            it = QListWidgetItem(icon, name)
            it.setData(Qt.UserRole, cmd)
            self.list.addItem(it)
        self.list.itemDoubleClicked.connect(lambda _: self.accept())
        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(self.accept)
        bb.rejected.connect(self.reject)
        lay = QVBoxLayout(self)
        lay.addWidget(QLabel("Pick a program to add to this qube:"))
        lay.addWidget(self.list, 1)
        lay.addWidget(bb)

    def accept(self):
        it = self.list.currentItem()
        if it:
            self.chosen = it.data(Qt.UserRole)
            super().accept()


class NewQube(QDialog):
    def __init__(self, parent):
        super().__init__(parent)
        self.setWindowTitle("New qube")
        self.name = QLineEdit()
        self.name.setPlaceholderText("for example: school, shopping, bank")
        self.kind = QComboBox()
        for key, title, about in KINDS:
            self.kind.addItem(f"{title}: {about}", key)
        self.tpl = QComboBox()
        self.tpl.addItem("Default for this type", None)
        for t_n in sorted(p.name for p in MQ.TEMPLATES.iterdir() if p.is_dir()) if MQ.TEMPLATES.is_dir() else []:
            self.tpl.addItem(t_n, t_n)
        self.tpl.setToolTip("Which base system it runs on. Pick a separate one for anything sensitive (Templates... makes them).")
        bb = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        bb.accepted.connect(self.accept)
        bb.rejected.connect(self.reject)
        form = QFormLayout(self)
        form.addRow("Name", self.name)
        form.addRow("Type", self.kind)
        form.addRow("Base system", self.tpl)
        form.addRow(bb)

    def accept(self):
        if not MQ.NAME_RE.match(self.name.text().strip()):
            QMessageBox.warning(self, "Name", "Use only small letters, numbers, - or _ (up to 32). "
                                              "For example: school")
            return
        super().accept()


