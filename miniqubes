#!/usr/bin/env python3
"""
miniqubes - sandboxed app boxes (templates, presets, create/list/run/delete)

Install:   sudo install -m755 miniqubes /usr/local/bin/      (needs: python 3.11+, bubblewrap)
Quick start with your existing Alpine rootfs:
    miniqubes template import alpine ~/microvm/alpine-root   # asks for sudo
    miniqubes create school --preset alpine
    miniqubes run school -- firefox

Model:
  template = a read-only root filesystem shared by boxes (root-owned, /var/lib/miniqubes/templates)
  box      = your config (~/.config/miniqubes/boxes/NAME.toml) + its home dir (~/.local/share/miniqubes/boxes/NAME)
  Admin happens from outside: `miniqubes template install/update` run the package manager inside the
  template as root, from the host. Nothing inside a box ever has admin.
"""
import argparse
import json
import os
import platform
import re
import shlex
import shutil
import struct
import subprocess
import sys
import tempfile
import tomllib
import urllib.request
from pathlib import Path

TEMPLATES = Path(os.environ.get("MQ_TEMPLATES", "/var/lib/miniqubes/templates"))
CONF = Path(os.environ.get("MQ_CONF", Path.home() / ".config/miniqubes/boxes"))
DATA = Path(os.environ.get("MQ_DATA", Path.home() / ".local/share/miniqubes/boxes"))

NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
COLOR_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
CHROOT_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ---------------------------------------------------------------- seccomp
# Syscall filter for boxed apps, applied by bwrap --seccomp. x86_64 only. The arch check kills
# the process on any other ABI, so an i386/x32 syscall can't dodge the list.
SYSCALLS = {  # name -> x86_64 syscall number
    "acct": 163, "add_key": 248, "adjtimex": 159, "bpf": 321, "chroot": 161,
    "clock_adjtime": 305, "clock_settime": 227, "delete_module": 176, "finit_module": 313,
    "fsconfig": 431, "fsmount": 432, "fsopen": 430, "fspick": 433, "init_module": 175,
    "io_uring_enter": 426, "io_uring_register": 427, "io_uring_setup": 425,
    "kexec_file_load": 320, "kexec_load": 246, "keyctl": 250, "mount": 165,
    "mount_setattr": 442, "move_mount": 429, "name_to_handle_at": 303, "nfsservctl": 180,
    "open_by_handle_at": 304, "open_tree": 428, "perf_event_open": 298, "personality": 135,
    "pivot_root": 155, "ptrace": 101, "process_vm_readv": 310, "process_vm_writev": 311,
    "quotactl": 179, "reboot": 169, "request_key": 249, "setns": 308, "settimeofday": 164,
    "swapoff": 168, "swapon": 167, "syslog": 103, "umount2": 166, "unshare": 272,
    "uselib": 134, "userfaultfd": 323, "vhangup": 153,
}
LOW = ["io_uring_setup", "io_uring_enter", "io_uring_register", "userfaultfd", "bpf",
       "perf_event_open", "kexec_load", "kexec_file_load", "init_module", "finit_module",
       "delete_module", "reboot", "swapon", "swapoff", "syslog", "acct"]
STANDARD = LOW + ["keyctl", "add_key", "request_key", "mount", "umount2", "pivot_root",
                  "move_mount", "open_tree", "fsopen", "fsconfig", "fsmount", "fspick",
                  "mount_setattr", "open_by_handle_at", "name_to_handle_at",
                  "process_vm_readv", "process_vm_writev", "ptrace",
                  "settimeofday", "clock_settime", "clock_adjtime", "adjtimex"]
STRICT = STANDARD + ["unshare", "setns", "personality", "chroot", "quotactl", "uselib",
                     "vhangup", "nfsservctl"]
# level -> (denied syscall names, also block namespace creation via clone/clone3)
SECCOMP_LEVELS = {
    "none": ([], False),
    "low": (LOW, False),
    "standard": (STANDARD, False),
    "strict": (STRICT, True),
    "custom": ([], False),  # custom uses the box's seccomp_deny list instead
}
CLONE_NS_FLAGS = 0x7E020000  # NEWNS|NEWCGROUP|NEWUTS|NEWIPC|NEWUSER|NEWPID|NEWNET


def build_seccomp(deny, block_ns):
    """Classic BPF program: default allow, EPERM for denied syscalls, optional namespace block."""
    ld_abs, jeq, jset, ret = 0x20, 0x15, 0x45, 0x06
    prog = [
        (ld_abs, None, None, 4),                        # arch
        (jeq, "ok", None, 0xC000003E),                  # AUDIT_ARCH_X86_64
        (ret, None, None, 0x80000000),                  # wrong arch: KILL_PROCESS
        "ok",
        (ld_abs, None, None, 0),                        # syscall number
    ]
    prog += [(jeq, "deny", None, SYSCALLS[n]) for n in deny]
    if block_ns:
        prog += [(jeq, "enosys", None, 435),            # clone3 packs flags in user memory,
                 (jeq, "clone", "allow", 56)]           # so force glibc back to clone
        prog += ["clone", (ld_abs, None, None, 16),     # clone flags = args[0] low 32 bits
                 (jset, "deny", "allow", CLONE_NS_FLAGS)]
    prog += ["allow", (ret, None, None, 0x7FFF0000),    # SECCOMP_RET_ALLOW
             "deny", (ret, None, None, 0x00050001),     # SECCOMP_RET_ERRNO(EPERM)
             "enosys", (ret, None, None, 0x00050026)]   # SECCOMP_RET_ERRNO(ENOSYS)

    labels, n = {}, 0
    for ins in prog:
        if isinstance(ins, str):
            labels[ins] = n
        else:
            n += 1
    out, n = b"", 0
    for ins in prog:
        if isinstance(ins, str):
            continue
        code, jt, jf, k = ins
        off = lambda lbl: 0 if lbl is None else labels[lbl] - n - 1
        out += struct.pack("<HBBI", code, off(jt), off(jf), k)
        n += 1
    return out


def seccomp_fd(deny, block_ns):
    """Memfd holding the BPF program, inheritable so bwrap --seccomp FD can read it."""
    fd = os.memfd_create("mq-seccomp")
    os.write(fd, build_seccomp(deny, block_ns))
    os.lseek(fd, 0, os.SEEK_SET)
    os.set_inheritable(fd, True)
    return fd


def check_seccomp(level, deny):
    if level not in SECCOMP_LEVELS:
        die(f"seccomp must be one of: {' | '.join(SECCOMP_LEVELS)}")
    bad = [s for s in deny if s not in SYSCALLS]
    if bad:
        die("unknown syscall(s): " + ", ".join(bad))


# ---------------------------------------------------------------- presets

PRESETS = {
    "alpine": dict(template="alpine", tier="trusted", network="direct", color="#2e7d32",
                   persistent=True, apps=["firefox"], seccomp="standard",
                   about="everyday trusted box on Alpine (small, fast)"),
