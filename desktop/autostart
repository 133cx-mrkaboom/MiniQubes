#!/bin/sh
# Started by labwc when the MiniQubes desktop starts. Edit freely.
D="${MQ_DESKTOP:-$HOME/.config/miniqubes/desktop}"
LP="${LABWC_PID:-$PPID}"   # the compositor: everything started here stops when it does

# wallpaper: Settings can change it (picture, solid color, light/dark); it restarts itself so changes show at once.
# (swaybg is a plain background layer, it can't be clicked, so clicking the wallpaper does nothing)
( while kill -0 "$LP" 2>/dev/null; do
    WALL=$(ls "$D"/wallpaper.png "$D"/wallpaper.jpg "$D"/wallpaper.jpeg 2>/dev/null | head -n1)
    THEME=$(cat "$D/theme" 2>/dev/null)
    COL=$(cat "$D/wallcolor" 2>/dev/null)
    if [ -z "$COL" ]; then if [ "$THEME" = light ]; then COL='#e6e8ee'; else COL='#14161c'; fi; fi
    if [ -n "$WALL" ]; then swaybg -m fill -i "$WALL"; else swaybg -c "$COL"; fi
    sleep 1
  done ) >/dev/null 2>&1 &

# build the Launcher menu (qube -> apps) before the bar starts, then keep it up to date
mq-menu --once >/dev/null 2>&1
mq-menu --daemon "$LP" >/dev/null 2>&1 &

# clipboard manager (only if installed); it sits in the bar's tray, Super+V opens it
command -v copyq >/dev/null 2>&1 && copyq --start-server >/dev/null 2>&1 &

# the bar; restarts itself if it crashes, but stops when the desktop ends (so sessions never pile up bars)
( while kill -0 "$LP" 2>/dev/null; do
    CSS="$D/waybar.css"
    if [ "$(cat "$D/theme" 2>/dev/null)" = light ] && [ -f "$D/waybar-light.css" ]; then CSS="$D/waybar-light.css"; fi
    waybar -c "$D/waybar.json" -s "$CSS"
    sleep 1
  done ) >/dev/null 2>&1 &
